# =============================================================================
# Faculty Management System — Environment Variables
# Copy to `.env` and fill in real values.
#
# SECURITY:
#   - Never commit a real `.env` to git.
#   - Treat all values here as secrets. The JWT and DB credentials are
#     especially sensitive.
#   - Use `openssl rand -base64 48` to generate secrets.
#   - In production, set `chmod 600 .env` and own it by the service user.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
JSON_BODY_LIMIT=5mb

# Set to 1 to trust the X-Forwarded-* headers from the nginx proxy. Required
# for correct req.ip and rate-limiting when running behind nginx.
TRUST_PROXY=1

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=faculty_management
DB_USER=faculty_app
DB_PASSWORD=CHANGE_ME_to_a_long_random_string
# The MySQL root password is only used by docker-compose to bootstrap the
# `faculty_app` user. The application itself only needs the `DB_PASSWORD`
# above. Choose a long random value.
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_to_a_long_random_string

# -----------------------------------------------------------------------------
# JWT
# Generate with: openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_one
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# SMTP (REQUIRED in production for password resets, approvals, etc.)
# Use a transactional provider (Mailgun, SendGrid, Postmark, AWS SES) or
# a Gmail App Password (NOT your normal Gmail password).
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@example.com
EMAIL_PASS=CHANGE_ME_smtp_app_password
EMAIL_FROM="Faculty Portal <noreply@example.com>"

# -----------------------------------------------------------------------------
# File uploads
# Must be in sync with nginx's `client_max_body_size` directive.
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=25

# -----------------------------------------------------------------------------
# Bulk import
# Password assigned to users created via the Excel bulk import. Must be
# overridden in production. Users are required to change this on first login.
# -----------------------------------------------------------------------------
BULK_IMPORT_DEFAULT_PASSWORD=CHANGE_ME_a_long_random_default

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins for cross-origin API calls.
# Leave empty if frontend and backend share an origin (the recommended setup).
# Example: CORS_ORIGIN=https://portal.example.com,https://admin.example.com
# -----------------------------------------------------------------------------
CORS_ORIGIN=

# -----------------------------------------------------------------------------
# Frontend (Vite)
# When the SPA is built, this is baked in. If empty, the SPA uses same-origin
# `/api`. Set to your backend's full URL only if you split them onto different
# hosts (e.g. Vite dev server, or CDN + API host).
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_DEV_SERVER_PORT=5173

# -----------------------------------------------------------------------------
# Application ports exposed on the Docker host (development / single-host prod)
# -----------------------------------------------------------------------------
APP_BACKEND_PORT=5000
APP_FRONTEND_PORT=8080
